# Auto detect text files and perform LF normalization
* text=auto

# ---------------------------------------------------------------------------
# Git LFS
#
# Raw captures, rendered images, video and model weights are binary, never
# usefully diffed, and large enough in aggregate to dominate repository
# history if stored as plain blobs.
#
# Patterns are case sensitive, so both spellings are listed where the camera
# and the tooling disagree.
# ---------------------------------------------------------------------------

# Camera raw
*.NEF   filter=lfs diff=lfs merge=lfs -text
*.nef   filter=lfs diff=lfs merge=lfs -text
*.DNG   filter=lfs diff=lfs merge=lfs -text
*.dng   filter=lfs diff=lfs merge=lfs -text
*.CR2   filter=lfs diff=lfs merge=lfs -text
*.cr2   filter=lfs diff=lfs merge=lfs -text
*.ARW   filter=lfs diff=lfs merge=lfs -text
*.arw   filter=lfs diff=lfs merge=lfs -text

# Rendered images
*.png   filter=lfs diff=lfs merge=lfs -text
*.PNG   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.JPG   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.JPEG  filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text

# Model weights
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.engine      filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
*.h264  filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Kept in plain git on purpose.
#
# The records, tables and notes beside the captures are the reproducibility
# trail. They are small, they diff usefully, and putting them behind LFS
# would make the history hard to read for no saving.
# ---------------------------------------------------------------------------
*.json  !filter !diff !merge text
*.csv   !filter !diff !merge text
*.md    !filter !diff !merge text
*.txt   !filter !diff !merge text
*.yaml  !filter !diff !merge text
*.yml   !filter !diff !merge text
