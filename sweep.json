  "generators": {
    "grayscale": {
      "script": "GenerateColorShift.py",
      "suffix": "_grayscale",
      "args": [
        "--formula",
        "Y",
        "Y",
        "Y",
        "--suffix",
        "_grayscale"
      ],
      "describe": "grayscale via BT.601 luma (Y to all channels)"
    },
    "white": {
      "script": "GenerateColorShift.py",
      "suffix": "_white",
      "args": [
        "--formula",
        "g*0.561",
        "g",
        "g*0.874",
        "--suffix",
        "_white"
      ],
      "describe": "white phosphor tint from data/day2night/nvg_config_selected_white.json (R'=g*0.561, G'=g, B'=g*0.874, ~85% luma)"
    },
    "red_light": {
      "script": "GenerateColorShift.py",
      "suffix": "_red_light",
      "args": [
        "--formula",
        "g",
        "g*0.5",
        "0",
        "--suffix",
        "_red_light"
      ],
      "describe": "red tint with luma support (R'=g, G'=g*0.5, B'=0, ~59% luma)"
    },
    "red_dark": {
      "script": "GenerateColorShift.py",
      "suffix": "_red_dark",
      "args": [
        "--formula",
        "g+b*0.7",
        "g*0.3",
        "0",
        "--suffix",
        "_red_dark"
      ],
      "describe": "original red blend analog (R'=g+b*0.7, G'=g*0.3, B'=0, ~38% luma)"
    },
    "red_swap": {
      "script": "GenerateColorShift.py",
      "suffix": "_red_swap",
      "args": [
        "--formula",
        "g",
        "b",
        "r",
        "--suffix",
        "_red_swap"
      ],
      "describe": "red channel rotation (R'=g, G'=b, B'=r, ~30% luma)"
    },
    "cl_c1p5_t4": {
      "script": "Preprocess.py",
      "suffix": "_cl_c1p5_t4",
      "args": [
        "--config",
        "data/preprocess/cl_c1p5_t4.json",
        "--quality",
        "95",
        "--suffix",
        "_cl_c1p5_t4"
      ],
      "describe": "step: CLAHE only, clip 1.5, tile 4 (selected CLAHE is 0.75/2), data/preprocess/cl_c1p5_t4.json"
    },
