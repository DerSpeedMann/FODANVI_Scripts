{
  "paths": {
    "datasets": "data/datasets",
    "models": "data/models",
    "processing": "src/Processing",
    "runs": "data/runs"
  },
  "datasets": [
    "coco",
    "coco_nvg_green_clean",
    "coco_nvg_green_noisy",
    "coco_nvg_white_clean",
    "coco_nvg_white_noisy",
    "coco_nvg2_green",
    "coco_nvg2_green_clean",
    "coco_nvg2_white",
    "coco_nvg2_white_clean",
    "real_nvg",
    "real_nvg_grayscale",
    "real_nvg_blue_light",
    "real_nvg_blue_dark",
    "real_nvg_blue_swap",
    "real_nvg_red_light",
    "real_nvg_red_dark",
    "real_nvg_red_swap"
  ],
  "validators": {
    "yolo": {
      "script": "yolo_val.py"
    },
    "rtdetr": {
      "script": "rtdetr_val_fixed.py"
    },
    "rfdetr": {
      "script": "rfdetr_val.py",
      "pip": "rfdetr==1.2.0 transformers==4.53.3 pycocotools",
      "needs_box_annotations": true
    }
  },
  "models": {
    "yolo11s": {
      "weight": "yolo11s.pt",
      "validator": "yolo"
    },
    "yolo12x": {
      "weight": "yolo12x.pt",
      "validator": "yolo"
    },
    "yolo11s_clean": {
      "weight": "yolo11s_clean.pt",
      "validator": "yolo"
    },
    "yolo11s_clean-noisy": {
      "weight": "yolo11s_clean-noisy.pt",
      "validator": "yolo"
    },
    "rtdetrx": {
      "weight": "rtdetr-x.pt",
      "validator": "rtdetr"
    },
    "rfdetrl": {
      "weight": "rf-detr-large.pth",
      "validator": "rfdetr"
    }
  },
  "generators": {
    "grayscale": {
      "script": "GenerateColorShift.py",
      "suffix": "_grayscale",
      "args": [
        "--formula",
        "Y",
        "Y",
        "Y",
        "--suffix",
        "_grayscale"
      ],
      "describe": "grayscale via BT.601 luma (Y to all channels)"
    },
    "blue_light": {
      "script": "GenerateColorShift.py",
      "suffix": "_blue_light",
      "args": [
        "--formula",
        "0",
        "g*0.5",
        "g",
        "--suffix",
        "_blue_light"
      ],
      "describe": "blue tint with luma support (R'=0, G'=g*0.5, B'=g, ~62% luma)"
    },
    "blue_dark": {
      "script": "GenerateColorShift.py",
      "suffix": "_blue_dark",
      "args": [
        "--formula",
        "r",
        "g*0.3",
        "b+g*0.7",
        "--suffix",
        "_blue_dark"
      ],
      "describe": "original blue blend (R'=r, G'=g*0.3, B'=b+g*0.7, ~39% luma)"
    },
    "blue_swap": {
      "script": "GenerateColorShift.py",
      "suffix": "_blue_swap",
      "args": [
        "--formula",
        "r",
        "b",
        "g",
        "--suffix",
        "_blue_swap"
      ],
      "describe": "green-blue channel swap (R'=r, G'=b, B'=g, ~17% luma)"
    },
    "red_light": {
      "script": "GenerateColorShift.py",
      "suffix": "_red_light",
      "args": [
        "--formula",
        "g",
        "g*0.5",
        "0",
        "--suffix",
        "_red_light"
      ],
      "describe": "red tint with luma support (R'=g, G'=g*0.5, B'=0, ~59% luma)"
    },
    "red_dark": {
      "script": "GenerateColorShift.py",
      "suffix": "_red_dark",
      "args": [
        "--formula",
        "g+b*0.7",
        "g*0.3",
        "0",
        "--suffix",
        "_red_dark"
      ],
      "describe": "original red blend analog (R'=g+b*0.7, G'=g*0.3, B'=0, ~38% luma)"
    },
    "red_swap": {
      "script": "GenerateColorShift.py",
      "suffix": "_red_swap",
      "args": [
        "--formula",
        "g",
        "b",
        "r",
        "--suffix",
        "_red_swap"
      ],
      "describe": "red channel rotation (R'=g, G'=b, B'=r, ~30% luma)"
    }
  },
  "variants": [
    {
      "source": "real_nvg",
      "chains": [
        [
          "grayscale"
        ],
        [
          "blue_light"
        ],
        [
          "blue_dark"
        ],
        [
          "blue_swap"
        ],
        [
          "red_light"
        ],
        [
          "red_dark"
        ],
        [
          "red_swap"
        ]
      ]
    }
  ]
}